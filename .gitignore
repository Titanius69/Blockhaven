# Rust build artifacts; keep the application's dependency lockfiles.
target/
.rustc_info.json
*.rs.bk
/.cargo/.package-cache*
/.cargo/registry/
/.cargo/git/
!Cargo.lock
!**/Cargo.lock

# Compiled binaries and distribution packages (publish these as Release assets).
*.exe
*.dll
!crates/blockhaven-installer/runtime/windows-x64/WebView2Loader.dll
*.pdb
*.ilk
*.exp
*.lib
*.a
*.o
*.obj
*.so
*.so.*
*.dylib
/dist/
/release/
/build/
/*.zip
/*.tar
/*.tar.gz
/*.7z
*.msi
*.msix
*.dmg
*.AppImage

# Local launcher settings, downloaded games, mods and caches.
/config.json
/installer.json
/accounts.json
/tokens.json
/games/
/instances/
/versions/
/libraries/
/assets/
/mods/
/removed-mods/
/icons/
/cache/
*.jar
*.jar.disabled
!tests/fixtures/**/*.jar

# Credentials and local environment; example configurations stay tracked.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!*.env.example
*.pem
*.key
*.pfx
*.p12

# Logs, crashes, editor backups and temporary files.
logs/
*.log
hs_err_pid*
replay_pid*
*.dmp
*.stackdump
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~

# Test coverage and optional Python / Node tooling.
/coverage/
/htmlcov/
*.profraw
*.profdata
lcov.info
/tarpaulin-report.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
/.tools/
/.toolchains/

# IDE state; share useful VS Code project configuration.
.idea/
.vs/
.fleet/
.history/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# Operating system metadata.
.DS_Store
._*
Thumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# Source artwork (.svg, .png, .ico, .rgba) remains tracked.
